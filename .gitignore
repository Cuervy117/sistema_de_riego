# ==========================================
# Quartus databases
db/
incremental_db/
greybox_tmp/
hc_output/
hps_isw_handoff/
sys_description/

# Synthesis/Compilation report and log files
*.rpt
*.summary
*.smsg
*.jdi
*.pin
*.done
*.qws
*.bak

# FPGA Programming / Output files (usually inside output_files/)
output_files/
*.sof
*.pof
*.ekp
*.jbc

