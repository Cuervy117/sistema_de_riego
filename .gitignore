# ==========================================
# GHDL & Simulation Outputs
# ==========================================
# GHDL compiler work directory
work/
# Simulation waveforms
*.vcd
*.ghw
# Object files and compiler intermediate files
*.o
e~*
# Testbench executables (if compiled standalone)
tb_*
*.cf

